{
    "name": "tutorialUI5.UI5project",
    "scripts": {
        "build": "mbt build --mtar tutorialUI5.UI5project.mtar",
        "build:workspaces": "npm run build --workspaces --if-present",
        "deploy": "cf deploy mta_archives/tutorialUI5.UI5project.mtar --retries 0",
